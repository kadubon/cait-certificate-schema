{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cait-schema.local/schemas/accounting/v1/evidence.schema.json",
  "title": "CAIT computation v1 evidence",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "scope": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "arm": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "artifact": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receiver": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "context": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "evaluator": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "protocol": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "check": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "valid_from": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "valid_until": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
      },
      "maxItems": 16,
      "minItems": 0
    },
    "blocking_defeaters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
      },
      "maxItems": 16,
      "minItems": 0
    },
    "cost_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
      },
      "maxItems": 16,
      "minItems": 0
    }
  },
  "required": [
    "id",
    "scope",
    "arm",
    "artifact",
    "receiver",
    "context",
    "evaluator",
    "protocol",
    "check",
    "outcome",
    "valid_from",
    "valid_until",
    "dependencies",
    "blocking_defeaters",
    "cost_ids"
  ],
  "additionalProperties": false
}
